{
  "name": "surname-roots",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run font:build && npm run font:verify && next build",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "next build && wrangler deploy",
    "preview": "next build && wrangler dev",
    "font:glyphs": "node scripts/write-glyphs.mjs",
    "font:build": "npm run font:glyphs && node scripts/build-font.mjs",
    "font:verify": "vitest run --config vitest.font.config.mts"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "fontkit": "^2.0.4",
    "jsdom": "^29.1.1",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  }
}
